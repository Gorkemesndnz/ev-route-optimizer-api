# ==============================================================================
# EV Route Optimizer API - Environment Variables
# ==============================================================================

# --- Environment ---
ENVIRONMENT=development  # development | production | staging | test
LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR

# --- API Keys ---
GOOGLE_API_KEY="your_google_api_key_here"
OCM_API_KEY="your_ocm_api_key_here"
OPENWEATHER_API_KEY="your_openweather_api_key_here"  # veya WEATHER_API_KEY

# --- Cache TTL (seconds) ---
CACHE_TTL_OCM=14400              # 4 saat
CACHE_TTL_WEATHER=3600           # 1 saat
CACHE_TTL_GOOGLE_PLACES=86400    # 24 saat
CACHE_TTL_GOOGLE_DIRECTIONS=3600 # 1 saat

# --- Route Selector ---
ROUTE_SELECTOR_THRESHOLD_PERCENT=0.10  # %10

# --- Sustainability / CO2 ---
CO2_AVG_ICE_CONSUMPTION=7.0     # L/100km ortalama benzinli araç
CO2_REGION_MULTIPLIER_TR=1.1    # Türkiye bölge çarpanı

# --- Data Logging ---
ENABLE_DATA_LOGGING=true        # ML training data loglaman J